{
  "name": "appium-webdriverio-mobile-e2e",
  "version": "1.0.0",
  "type": "module",
  "description": "Cross-platform mobile E2E automation framework for Android and iOS using Appium, WebdriverIO, Screen Object Pattern, Allure Reports, and BrowserStack.",
  "scripts": {
    "lint": "eslint test/ config/",
    "test:android": "wdio run ./config/wdio.android.conf.js",
    "test:ios": "wdio run ./config/wdio.ios.conf.js",
    "test:bs": "wdio run ./config/wdio.android.bs.conf.js",
    "report": "allure generate allure-results --clean && allure open"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@wdio/allure-reporter": "^9.20.0",
    "@wdio/appium-service": "^9.20.0",
    "@wdio/browserstack-service": "^9.20.1",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "allure-commandline": "^2.34.1",
    "appium-uiautomator2-driver": "^6.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-wdio": "^9.16.2"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
